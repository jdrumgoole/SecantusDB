# Example secantusd.toml.
#
# Read by both Mongo-wire daemons (secantusd-py and secantusd-rs); the
# legacy secantusdb.toml name is still discovered at each location.
#
# Copy to one of the auto-discovery paths and edit:
#   ./secantusd.toml                   (per-checkout / per-cwd)
#   ~/.secantus/secantusd.toml         (per-user)
#   /etc/secantus/secantusd.toml       (system-wide)
#
# Or pass it explicitly: secantusd-py --config /path/to/secantusd.toml
#
# Every key is optional. Missing keys use the SecantusConfig default
# (printed in the comment after each line). Explicit CLI flags
# override anything set here, so this file is the per-deployment
# baseline.

[server]
host = "127.0.0.1"            # default: "127.0.0.1" (loopback only)
port = 27017                  # default: 27017
storage_path = "./secantus-data"  # default: "./secantus-data"
log_level = "INFO"            # default: "INFO"; one of DEBUG / INFO / WARNING / ERROR
auth = false                  # default: false; true requires SCRAM-SHA-256 on every non-handshake command
standalone = false            # default: false (advertise as single-node "secantus" replica set so pymongo change streams work)

[oplog]
retention_seconds = 3600.0    # default: 3600 (1 hr); resume tokens minted before this fall outside the window
max_entries = 100000          # default: 100000; whichever cap (this or retention) hits first prunes oldest
noop_heartbeat_seconds = 0.0  # default: 0 (disabled); mongod's default is 10s — set to advance cluster time during idle stretches
# archive_dir = "/var/lib/secantus/pitr-archive"  # default: off; PITR v2 — archive pruned oplog rows here so recovery can reach before the live floor (pair with secantusAdmin.archiveBaseSnapshot)

[storage]
cache_size = "1G"             # default: "1G"; WT cache, unit-suffixed string ("256M", "1G", "8G")
session_max = 1000            # default: 1000; concurrent WT sessions, one per client connection
ttl_sweep_seconds = 60.0      # default: 60.0; background TTL pruning cadence (matches mongod)
sync_on_commit = false        # default: false; true forces per-commit fsync (closes writeConcern j:true gap; 1-2 orders of magnitude throughput cost)

# [tls]
# Both keys are optional — but if you set one you must set both
# (half-configured TLS would be a silent deployment mistake).
# When both are set, the daemon wraps every accepted socket in TLS
# before the wire protocol starts; clients connect with
# ?tls=true&tlsCAFile=<ca>. Without this section the daemon stays
# plaintext.
# cert_file = "/etc/letsencrypt/live/db.example.com/fullchain.pem"
# key_file  = "/etc/letsencrypt/live/db.example.com/privkey.pem"
#
# mTLS: when ca_file is set, the daemon asks connecting clients for
# their own X.509 cert during the handshake and verifies it against
# this CA bundle. Only meaningful when cert_file / key_file are also
# set. require_client_cert=true rejects clients without a cert;
# false (default) verifies a cert if presented, accepts clients
# without one (CERT_OPTIONAL — useful for staged rollouts).
# ca_file = "/etc/ssl/client-ca.crt"
# require_client_cert = false
